// ============================================================
// SCHEMA DO BANCO DE DADOS — GYM CAPITAL
// ============================================================
//
// Banco: PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USUÁRIO — cadastro, login e preferências
// ============================================================

model User {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  senhaHash       String   // bcrypt (nunca a senha em texto puro)
  dataNascimento DateTime
  cpf             String?  @unique

  // Preferências de exibição
  idioma          String   @default("pt-BR")  // "pt-BR", "en-US", "es-ES"
  moeda           String   @default("BRL")    // "BRL", "USD", "EUR"
  avatarUrl       String?  @db.Text           // foto em base64 ou URL

  aceitouTermos  Boolean  @default(false)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  sessoes         Sessao[]

  @@index([email])
}

// ============================================================
// SESSÃO — preparada caso queiram persistir sessões no futuro
// ============================================================

model Sessao {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiraEm   DateTime
  criadaEm   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}
