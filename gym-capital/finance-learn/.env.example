# ============================================================
# CONFIGURAÇÃO DO BANCO DE DADOS — SUPABASE
# ============================================================
#
# Como obter estas URLs:
#   1. Crie conta em https://supabase.com (pode usar o GitHub)
#   2. "New project" → escolha nome "gym-capital" e uma senha forte para o banco
#   3. Aguarde ~2 minutos enquanto o projeto é provisionado
#   4. Vá em "Settings → Database" (no menu lateral, ícone de engrenagem)
#   5. Role até "Connection string"
#   6. Selecione a aba "URI"
#   7. Copie as duas connection strings:
#      - "Transaction" (porta 6543) → cole em DATABASE_URL
#      - "Session" ou "Direct connection" (porta 5432) → cole em DIRECT_URL
#   8. Troque [YOUR-PASSWORD] pela senha do banco que você definiu
#
# IMPORTANTE: nunca commite este arquivo com as senhas reais!

# URL para queries da aplicação (com pooler — porta 6543)
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta (porta 5432) — usada SÓ pelo Prisma para migrações
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================================
# AUTENTICAÇÃO
# ============================================================

# Chave secreta para assinar tokens JWT (mínimo 32 caracteres)
# Em produção, gere uma nova com: openssl rand -base64 32
JWT_SECRET="troque-isto-por-uma-chave-secreta-de-pelo-menos-32-caracteres"
